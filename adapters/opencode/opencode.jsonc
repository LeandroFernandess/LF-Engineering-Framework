{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "AGENTS.md",
    "LF_ENGINEERING.md",
    ".ai/workflow.md",
    ".ai/contracts.md",
    ".ai/state/project-summary.md",

    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/knowledge/INDEX.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/knowledge/REGISTRY.md",

    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/protocols/AGENT_HANDOFF.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/protocols/WORKFLOW_UPDATE.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/protocols/TASK_UPDATE.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/protocols/DECISION_RECORD.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/protocols/ARTIFACT_UPDATE.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/protocols/PERFORMANCE_VALIDATION.md",

    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/AGENTS.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/agents/Engineering-Manager/SPECS.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/workflows/NEW_PROJECT.md",
    "https://raw.githubusercontent.com/LeandroFernandess/LF-Engineering-Framework/__LF_ENGINEERING_SYSTEM_REF__/workflows/STANDARD_DEVELOPMENT.md"
  ],

  "references": {
    "lf-engineering-framework": {
      "repository": "LeandroFernandess/LF-Engineering-Framework",
      "branch": "__LF_ENGINEERING_SYSTEM_REF__",
      "description": "Use as the external read-only LF Engineering System repository, including agents, workflows, protocols, schemas and knowledge."
    }
  },

  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*/repos/github.com/LeandroFernandess/LF-Engineering-Framework/*", "effect": "allow" },
    { "action": "read", "resource": "*/repos/github.com/LeandroFernandess/LF-Engineering-Framework/*", "effect": "allow" },
    { "action": "edit", "resource": "*/repos/github.com/LeandroFernandess/LF-Engineering-Framework/*", "effect": "deny" }
  ]
}
